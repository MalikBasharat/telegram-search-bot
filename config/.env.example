# Telegram API Credentials
# Obtain these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Telegram User IDs (comma-separated integers allowed to use the bot)
# You can find your Telegram User ID from @userinfobot
ADMIN_USER_IDS=your_telegram_user_id

# Optional: Phone number for MTProto User Client (if crawling private channels you joined)
TELEGRAM_PHONE_NUMBER=

# Optional: Iranian Proxy for bypassing Downloadly.ir / Soft98 geoblocks
# Format: socks5://user:pass@host:port or http://host:port
IRAN_PROXY=

# Optional: Keep downloaded files locally after Telegram delivery (default: false)
KEEP_LOCAL_COPY=false
